# GEMINI_API_KEY / VITE_GEMINI_API_KEY:
# Khóa API Gemini cấp dùng chung cho ứng dụng (tự động kích hoạt cho mọi học viên).
# Thầy/cô chỉ cần dán API Key vào đây hoặc cấu hình Environment Variable trên Vercel.
VITE_GEMINI_API_KEY=""
GEMINI_API_KEY=""

# APP_URL: Public URL of the deployed application.
APP_URL=""

# ADMIN_PASSCODE: Passcode for School Admin Dashboard.
ADMIN_PASSCODE=""

# GOOGLE_APPS_SCRIPT_URL: Deployed Google Apps Script Web App URL
GOOGLE_APPS_SCRIPT_URL=""

# GOOGLE_APPS_SCRIPT_SECRET: Shared secret token
GOOGLE_APPS_SCRIPT_SECRET=""
